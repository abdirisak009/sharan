# Copy to .env.local and fill in. Read by the website and by scripts/db-setup.mjs.
DATABASE_URL=postgres://sharan:CHANGE_ME@127.0.0.1:5433/sharan

# Used once by the database setup (npm run db:setup) to create the first admin account.
ADMIN_EMAIL=admin@sharan-somalia.org
ADMIN_NAME=SHARAN Admin
ADMIN_PASSWORD=at-least-10-characters
