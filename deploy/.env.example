# Copy to deploy/.env on the server and fill in. Use long random
# passwords (e.g. `openssl rand -base64 24`).
POSTGRES_PASSWORD=change-me
MINIO_ROOT_USER=sharan-minio
MINIO_ROOT_PASSWORD=change-me-too

# Only used the first time the site starts, to create the first admin.
# Once you can sign in, delete ADMIN_PASSWORD from this file and run
# `docker compose up -d` again so it is no longer kept on the server.
ADMIN_EMAIL=admin@sharan-somalia.org
ADMIN_NAME=SHARAN Admin
ADMIN_PASSWORD=at-least-10-characters

SITE_DOMAIN=sharan-somalia.org
# The server's public IP: visitors to the bare IP are redirected to the domain.
SERVER_IP=13.140.146.169
COOKIE_SECURE=true

# How many days of nightly backups to keep in deploy/backups/.
BACKUP_KEEP_DAYS=14
